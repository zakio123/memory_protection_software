+// === Self-check (NIST SP 800-38A example) ====
+// key = 2b7e151628aed2a6abf7158809cf4f3c
+// pt  = 6bc1bee22e409f96e93d7e117393172a
+// ct  = 3ad77bb40d7a3660a89ecaf32466ef97
+inline bool self_test() {
+  const Block key = { 0x2b,0x7e,0x15,0x16,0x28,0xae,0xd2,0xa6,
+                      0xab,0xf7,0x15,0x88,0x09,0xcf,0x4f,0x3c };
+  const Block pt  = { 0x6b,0xc1,0xbe,0xe2,0x2e,0x40,0x9f,0x96,
+                      0xe9,0x3d,0x7e,0x11,0x73,0x93,0x17,0x2a };
+  const Block exp = { 0x3a,0xd7,0x7b,0xb4,0x0d,0x7a,0x36,0x60,
+                      0xa8,0x9e,0xca,0xf3,0x24,0x66,0xef,0x97 };
+  AES128 aes(key);
+  auto ct = aes.encrypt_block(pt);
+  return ct == exp;
+}
