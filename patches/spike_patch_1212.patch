+    std::cout << " " << *a;
+  std::cout << std::endl;
+  // mems を構築
+  auto mems = make_mems(cfg.mem_layout);
+  std::cout << "log file name is " << (log_path ? log_path : "null") << std::endl;
+if (mems.empty()) {
+    std::cerr << "FATAL ERROR: mems vector is empty!" << std::endl;
+    std::cerr << "This will cause a segfault." << std::endl;
+    // ここで処理を中断する (例外を投げる、exitする など)
+    throw std::runtime_error("Memory subsystem failed to initialize.");
+}
+ if (trace_data_file_path) {
+    const char *path = trace_data_file_path;
+      const reg_t TRACE_DATA_BASE = memreq_mmio_device_t::TRACE_DATA_BASE;
+    const reg_t load_addr = TRACE_DATA_BASE;
+    size_t file_size = get_file_size(path);
+    std::cout << "[Spike] Trace data file size: " << file_size << " bytes" << std::endl;
+    // ★ 正しい領域検出と offset 計算
+    bool loaded = false; // ★ 変数 loaded をループの外で宣言
+      for (auto& m : mems) {
+        reg_t base = m.first;
+        auto  mem  = m.second;
+        // ロード範囲 [load_addr, load_addr + file_size) が
+        // メモリ領域 [base, base + mem->size()) に収まっているか確認
+        std::cout << "[Spike] Checking memory region [" << std::hex << base << ", " << (base + mem->size()) << ")" << std::dec << std::endl;
+        if (load_addr >= base && (load_addr + file_size) <= (base + mem->size())) {
+          // メモリ領域の先頭からのオフセットを計算
+          reg_t memoff = load_addr - base; 
+          // ▲▲▲ ここまで修正 ▲▲▲
+
+          read_file_bytes(path, 0, mem, memoff, file_size);
+          fprintf(stderr,
+            "[Spike] Loaded %zu bytes from '%s' into memory [%#" PRIx64 ", %#" PRIx64 ")\n",
+            file_size, path, load_addr, load_addr + file_size);
+          loaded = true;
+          break; // ロード完了したらループを抜ける
+        }
+      }
+      if (!loaded) {
+        fprintf(stderr,
+          "Error: trace data region [%#" PRIx64 ", %#" PRIx64 ") doesn't fit any mem region\n",
+          load_addr, load_addr + (reg_t)file_size);
+        exit(1);
+      }
+  }
+  if (init_image_file_path) {
+    const char *path = init_image_file_path;
+    size_t file_size = get_file_size_fs(path).value_or(0);
+    std::cout << "[Spike] Initial image file size: " << file_size << " bytes" << std::endl;
+    uint64_t INIT_IMAGE_BASE = 0x90000000;
+    // ★ 正しい領域検出と offset 計算
+      bool loaded = false; // ★ 変数 loaded をループの外で宣言
+      for (auto& m : mems) {
+        reg_t base = m.first;
+        auto  mem  = m.second;
+        // ▼▼▼ ここから修正 ▼▼▼
+        std::cout << "[Spike] Checking memory region [" << std::hex << base << ", " << (base + mem->size()) << ")" << std::dec << std::endl;
+        if (file_size <= mem->size()&& (INIT_IMAGE_BASE + file_size) <= (base + mem->size())) {
+          reg_t memoff = INIT_IMAGE_BASE - base; // ★ 固定アドレス 0x90000000 からロードする場合のオフセット計算
+          
+          read_file_bytes(path, 0, mem, memoff, file_size);
+          fprintf(stderr,
+            "[Spike] Loaded %zu bytes from '%s' into memory [%#" PRIx64 ", %#" PRIx64 ")\n",
+            file_size, path, INIT_IMAGE_BASE, INIT_IMAGE_BASE + file_size);
+          loaded = true;
+          break; // ロード完了したらループを抜ける
+        }
+      }
+      if (!loaded) {
+        fprintf(stderr,
+          "Error: initial image size (%#" PRIx64 " bytes) doesn't fit any mem region\n",
+          file_size);
+        exit(1);
+      }
+  }
+  if (kernel && check_file_exists(kernel)) {
+    const char *isa = cfg.isa;
+    kernel_size = get_file_size(kernel);
+    if (isa[2] == '6' && isa[3] == '4')
+      kernel_offset = 0x200000;
+    else
+      kernel_offset = 0x400000;
+    for (auto& m : mems) {
+      if (kernel_size && (kernel_offset + kernel_size) < m.second->size()) {
+         read_file_bytes(kernel, 0, m.second, kernel_offset, kernel_size);
+         break;
+      }
+    }
+  }
+
+  if (initrd && check_file_exists(initrd)) {
+    size_t initrd_size = get_file_size(initrd);
+    for (auto& m : mems) {
+      if (initrd_size && (initrd_size + 0x1000) < m.second->size()) {
+         reg_t initrd_end = m.first + m.second->size() - 0x1000;
+         reg_t initrd_start = initrd_end - initrd_size;
+         cfg.initrd_bounds = std::make_pair(initrd_start, initrd_end);
+         read_file_bytes(initrd, 0, m.second, initrd_start - m.first, initrd_size);
+         break;
+      }
+    }
+  }
+
+  if (cfg.explicit_hartids) {
+    if (nprocs.overridden() && (nprocs() != cfg.nprocs())) {
+      std::cerr << "Number of specified hartids ("
+                << cfg.nprocs()
+                << ") doesn't match specified number of processors ("
+                << nprocs() << ").\n";
+      exit(1);
+    }
+  } else {
+    // Set default set of hartids based on nprocs, but don't set the
+    // explicit_hartids flag (which means that downstream code can know that
+    // we've only set the number of harts, not explicitly chosen their IDs).
+    std::vector<size_t> default_hartids;
+    default_hartids.reserve(nprocs());
+    for (size_t i = 0; i < nprocs(); ++i) {
+      default_hartids.push_back(i);
+    }
+    cfg.hartids = default_hartids;
+  }
+  // ここから main.cc の「ファイルロード（trace/init_image/kernel/initrd）」の処理を流用
+  // （あなたの現在の main.cc と同じロジックを移植）
+  // read_file_bytes(), get_file_size(), memoff計算など
+
+  // hartids/nprocs の処理（main と同じ）
+  if (!cfg.explicit_hartids) {
+    std::vector<size_t> default_hartids(cfg.nprocs());
+    for (size_t i=0;i<cfg.nprocs();++i) default_hartids[i]=i;
+    cfg.hartids = default_hartids;
+  }
+
+  // sim_t を new して返す（呼び側で delete）
+  auto *s = new sim_t(&cfg, halted,
+      mems, plugin_device_factories, htif_args, dm_config, log_path, dtb_enabled, dtb_file,
+      socket,
+      cmd_file,
+      instructions);
+    std::unique_ptr<remote_bitbang_t> remote_bitbang((remote_bitbang_t *) NULL);
+   std::cout << "  sim_ptr->debug_mmu: " << (void*)(s->debug_mmu) << "\n";
+  // 4. (重要) debug_mmu が null でないことをアサートする
+  assert(s->debug_mmu != nullptr && "FATAL: debug_mmu is NULL!"); 
+  // std::unique_ptr<jtag_dtm_t> jtag_dtm(
+  //     new jtag_dtm_t(s->debug_module, dmi_rti));
+  // if (use_rbb) {
+  //   remote_bitbang.reset(new remote_bitbang_t(rbb_port, &(*jtag_dtm)));
+  //   s.set_remote_bitbang(&(*remote_bitbang));
+  // }
+
+  // if (dump_dts) {
+  //   printf("%s", s.get_dts());
+  //   return 0;
+  // }
+
+  if (ic && l2) ic->set_miss_handler(&*l2);
+  if (dc && l2) dc->set_miss_handler(&*l2);
+  if (ic) ic->set_log(log_cache);
+  if (dc) dc->set_log(log_cache);
+  for (size_t i = 0; i < cfg.nprocs(); i++)
+  {
+    if (ic) s->get_core(i)->get_mmu()->register_memtracer(&*ic);
+    if (dc) s->get_core(i)->get_mmu()->register_memtracer(&*dc);
+    for (auto e : extensions)
+      s->get_core(i)->register_extension(e());
+  }
+
+  s->set_debug(debug);
+  s->configure_log(log, log_commits);
+  s->set_histogram(histogram);
+  s->core_start();
+  std::cout << "Spike C++ API: sim_t built successfully\n" << std::endl;
+  return s;
+}
