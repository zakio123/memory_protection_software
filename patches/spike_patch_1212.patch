+}
+// [SPM -> sim_t] Read要求
+bool sim_t::external_dma_read(reg_t paddr, size_t len, std::function<void(void)> completion_cb, uint64_t process_id)
+{
+    // 1. 完了コールバックを登録
+    inflight_dma_read_callbacks[paddr] = completion_cb;
+    // 2. リクエストをChampsim用のキューに追加
+    dma_request_queue.push({process_id, paddr, len, false,true});  
+    read_dma_count++; // 読み込みDMA完了回数をインクリメント
+    return true; // (キューが満杯の場合のエラー処理は省略)
+}
+
+// [SPM -> sim_t] Write要求
+bool sim_t::external_dma_write(reg_t paddr, size_t len, std::function<void(void)> completion_cb, uint64_t process_id)
+{  // 1. 完了コールバック (ACK) を登録
+    inflight_dma_write_callbacks[paddr] = completion_cb;
+    dma_request_queue.push({process_id, paddr, len, true,false});
+    write_dma_count++; // 書き込みDMA完了回数をインクリメント
+    return true;
+}
+
+// [Champsim -> sim_t] FWDからの完了通知
+bool sim_t::dma_notify_completion(uint64_t address)
+{
+    // Readコールバックを探す
+    auto read_it = inflight_dma_read_callbacks.find(address);
+    if (read_it != inflight_dma_read_callbacks.end()) {
+        read_it->second(); // ★ SPMのコールバック(Read)を実行
+        inflight_dma_read_callbacks.erase(read_it);
+        return true;
+    }
+    // Writeコールバックを探す
+    auto write_it = inflight_dma_write_callbacks.find(address);
+    if (write_it != inflight_dma_write_callbacks.end()) {
+        write_it->second(); // ★ SPMのコールバック(Write ACK)を実行
+        inflight_dma_write_callbacks.erase(write_it);
+        return true;
+    }
+    return false;
+}
