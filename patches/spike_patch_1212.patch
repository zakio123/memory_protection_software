--- /dev/null
+++ b/riscv/double_device.h
@@ -0,0 +1,29 @@
+// spike/src/double_device.h
+#pragma once
+#include "devices.h"   // abstract_device_t
+#include <cstdint>
+#include <cstring>
+
+class double_device_t : public abstract_device_t {
+public:
+  double_device_t() : in_reg(0) {}
+
+// 必須3点（シグネチャを devices.h と完全一致させる）
+  bool load(reg_t addr, size_t len, uint8_t* bytes) override {
+    if (addr != 0 || (len != 4 && len != 8)) return false;
+    uint64_t out = static_cast<uint32_t>(in_reg) * 2u;  // 2倍
+    std::memcpy(bytes, &out, len);                      // RV64のld(8B)にも対応
+    return true;
+  }
+
+  bool store(reg_t addr, size_t len, const uint8_t* bytes) override {
+    if (addr != 0 || len != 4) return false;            // 32bitストアのみ受け付け
+    std::memcpy(&in_reg, bytes, 4);
+    return true;
+  }
+
+  reg_t size() override { return 0x1000; } 
+
+private:
+  uint32_t in_reg;
+};
