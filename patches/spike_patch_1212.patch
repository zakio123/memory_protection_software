+    }
+    void return_data_push(const Otp& data, uint32_t req_id, int index){
+        auto it = m_response_buffers.find(req_id);
+        if (it == m_response_buffers.end()) {
+            m_response_buffers[req_id] = DataBlock{}; // ゼロ初期化
+        }
+        // 2. 適切なオフセットに16バイト(128bit)をコピー
+        // index 0 -> 0-15 byte
+        // index 1 -> 16-31 byte ...
+        size_t offset = index * 16;
+        if (offset + 16 <= 64) {
+            std::memcpy(&m_response_buffers[req_id][offset], data.data(), 16);
+        } else {
+            std::cout << "  [AXIM HW] Error: Buffer overflow for ID " << req_id << "\n";
+        }
+    }
+    Otp write_data_pop(uint32_t req_id, int index){
+        // if(m_write_data_fifo.empty()) return {};
+        auto it = m_inflight_queue.find(req_id);
+        if (it == m_inflight_queue.end()) {
+            std::cout << "  [AXIM HW] Error: No inflight request found for Write Data Pop with ID " << req_id << ".\n";
+            return {};
+        }
+        auto req = it->second;
+        auto datablock = it->second.data;
+        // 16バイトを適切なオフセットにコピー
+        Otp chunk;
+        std::memcpy(chunk.data(), &datablock[index * 16], 16);
+        return chunk;
+    }
+
+private:
+    void executeCommand(uint64_t command) {
+        m_busy_reg = 1;
+        uint32_t comp_id = command >> 32; 
+        if (command & 1) { // Data Write Back (W Buffer -> SPM)
+            // spm->write_back_local(m_spm_addr_reg, m_w_buffer.data());
+            // 特になし
+        }
+        if (command & 16) { // Read Response (R Buffer -> LLC)
+            // auto req = m_request_queue.front(); m_request_queue.pop();
+            auto it = m_inflight_queue.find(comp_id);
+            if (it == m_inflight_queue.end()) {
+                std::cout << "  [AXIM HW] Error: No inflight request found for Read Response with ID " << comp_id << ".\n";
+                m_busy_reg = 0;
+                return;
+            }
+            else {
+                auto req = it->second;
+                m_inflight_queue.erase(it); // イテレータで削除
+                // rest_queue_size += m_request_queue.size();
+                auto data = m_response_buffers.find(comp_id);
+                if (data == m_response_buffers.end()) {
+                    std::cout << "  [AXIM HW] Error: No response buffer found for Read Response with ID " << comp_id << ".\n";
+                    m_busy_reg = 0;
+                    return;
+                }
+                m_response_buffers.erase(comp_id);
+                if(req.read_cb) req.read_cb(data->second);
+            }
+            // auto req = m_inflight_queue[comp_id];
+            // }
+        }
+        if (command & 32) { // Write Response (ACK -> LLC)
+            // if (!m_request_queue.empty() && m_request_queue.front().is_write) {
+            auto it = m_inflight_queue.find(comp_id);
+            if (it == m_inflight_queue.end()) {
+                std::cout << "  [AXIM HW] Error: No inflight request found for Write Response with ID " << comp_id << ".\n";
+                m_busy_reg = 0;
+                return;
+            }
+            else {
+                auto req = it->second;
+                m_inflight_queue.erase(it); // イテレータで削除
+                // rest_queue_size += m_request_queue.size();
+                if(req.write_cb) req.write_cb(true); // 常に成功を返す
+            }
+        }
+        m_busy_reg = 0;
+    }
+    sim_t* sim;
+    // spm_device_t* spm;   // ★ SPM実体への生ポインタ（または参照/unique_ptr等）
+    // --- 内部状態 ---
+    std::queue<LlcRequest> m_request_queue;
+    std::map<uint64_t, LlcRequest> m_inflight_queue; // 処理中 (Random Access必要)
+    std::queue<Otp> m_otp_fifo;
+    DataBlock m_r_buffer{}; // Read Buffer
+    DataBlock m_w_buffer{}; // Write Buffer
+    uint64_t rest_queue_size = 0;
+    uint64_t total_req_count_read = 0;
+    uint64_t total_req_count_write = 0;
+    // MMIOレジスタの状態
+    uint64_t m_spm_addr_reg = 0;
+    uint64_t m_busy_reg = 0;
+    uint64_t idle = 0;
+    
+
+    // XORとデータのやり取りを行うためのFIFOキュー
+    std::queue<Otp> m_return_data_fifo;
+    std::queue<Otp> m_write_data_fifo;
+
+    // return データバッファ
+    std::map<uint32_t, DataBlock> m_response_buffers;
+};
diff --git a/riscv/mmio_devices/mac_device.h b/riscv/mmio_devices/mac_device.h
new file mode 100644
index 00000000..967df290
--- /dev/null
+++ b/riscv/mmio_devices/mac_device.h
@@ -0,0 +1,146 @@
+#pragma once
+#include "devices.h"
+#include "sim.h"
+#include "mmio_devices/spm_device.h"
+
+#include "mmio_map.h"
+#include "setting.h"
+#include <vector>
+#include <cstring>
+#include <cstdint>
+#include <algorithm>
+class mac_mmio_device_t final : public abstract_device_t {
+public:
+  mac_mmio_device_t(sim_t* sim, spm_device_t* spm_device)
+  : sim(sim), spm_device(spm_device) { reset_state(); }
+
+reg_t size() override { return mac_addrmap_t::CTRL_SIZE; }
+    // MMIO read
+    bool load(reg_t addr, size_t len, uint8_t* bytes) override {
+        if (len != 8) return false;
+        uint64_t v = 0;
+        switch (addr) {
+            case mac_addrmap_t::REG_STATUS:      v = status;      break;
+            case mac_addrmap_t::REG_MAC_ID:      v = complete_id;         break;
+            default: return false; // 他は読み不可
+        }
+        std::memcpy(bytes, &v, 8);
+        return true;
+    }
+    bool store(reg_t addr, size_t len, const uint8_t* bytes) override {
+        if (len != 8) return false;
+        uint64_t v; std::memcpy(&v, bytes, 8);
+        switch (addr) {
+            case mac_addrmap_t::REG_COMMAND:{
+                command_queue.push(v);
+                return true;
+            }
+            default: return false; // 他は書き不可
+        }
+    }
+    void tick(reg_t /*rtc_ticks*/) override {
+    // コマンドの構成
+    // | bit 0 | bit 1 | bit 2 | bit 3 |  その他   |
+    // | INIT  | UPDATE| OUTPUT| SPM_RD| 予約済み | 
+    if (!status) {
+        if (!command_queue.empty()) {
+            command = command_queue.front();
+            command_queue.pop();
+            this->command_type = command & 0x0FF;
+            if (command_type == 1) { // INIT　リクエストIDを受け取る
+                this->req_id = (command >> 32) & 0xFFFFFFFF; // 上位32ビットにリクエストIDが入っていると仮定
+                reset_state();
+            } else if (command_type == 2) { // UPDATE
+                this->start_bit = (command >> 32) & 0xFFFF; // bit 32-47
+                this->end_bit   = (command >> 48) & 0xFFFF; // bit 48-63
+                update();
+            } else if (command_type == 4) { // SPMへOUTPUT
+                status = 1;      
+                this->spm_addr = (command >> 32) & 0xFFFFFFFF; // 上位32ビットにSPMアドレスが入っていると仮定
+            } else if (command_type == 8) { // SPM_RD
+                // 上位32ビットにSPMアドレスが入っていると仮定
+                this->spm_addr = (command >> 32) & 0xFFFFFFFF;
+                spm_device->write(spm_addr, buffer, 64);
+            } else if (command_type == 16) { // 比較計算
+                status = 1;
+                this->spm_addr = (command >> 32) & 0xFFFFFFFF; // 上位32ビットにSPMアドレスが入っていると仮定
+            } else {
+                // 未知のコマンド
+            }
+        } 
+    } else {
+        // 何かしらのコマンドを実行中
+        counter++;
+        if (counter >= mmio_delay_tick_t::MAC_TICK) {
+            counter = 0;
+            if (command_type == 4) {
+                // OUTPUT完了。SPMへ書き込み
+                spm_device->copy(this->spm_addr, reinterpret_cast<uint8_t*>(&this->mac), 8);
+                this->complete_id = this->req_id;
+            } else if (command_type == 16) {
+                // 比較計算完了
+                spm_device->write(this->spm_addr, reinterpret_cast<uint8_t*>(&this->exact_mac), 8);
+                this->complete_id = this->req_id;
+                if (this->mac != this->exact_mac){
+                    std::cout << "[MAC] Digest mismatch: calculated=" << std::hex << this->mac << ", expected=" << this->exact_mac << std::dec << "\n";
+                }
+            }
+            status = 0;
+        }
+        return ; 
+    }
+}
+
+private:
+    // FNV-1aハッシュ用の定数 (64bit版)
+    static constexpr uint64_t FNV_PRIME = 0x100000001b3;
+    static constexpr uint64_t FNV_OFFSET_BASIS = 0xcbf29ce484222325;
+    void start_dma() {
+        busy = true;
+        return;
+    }
+    void reset_state(){
+        spm_addr = 0;
+        command = 0;
+        start_bit = 0;
+        end_bit = 0;
+        mac = FNV_OFFSET_BASIS;
+        counter = 0;
+        busy = false;
+        status = 0;
+    }
+  // FOV-1aのMAC演算  (64bit)
+  void update(){
+    uint64_t start_byte = start_bit / 8;
+    uint64_t end_byte = (end_bit) / 8;
+    if (end_byte >= 64 || start_byte > end_byte) {
+        //  std::cout << "  [Hash HW] ERROR: Invalid bit range.\n";
+    } else {
+        // FNV-1aアルゴリズムをそのバイト範囲で実行
+        for (uint64_t i = start_byte; i <= end_byte; ++i) {
+            uint8_t upper_mask = (i == start_byte) ? (0xFF << (start_bit % 8)) : 0xFF;
+            uint8_t lower_mask = (i == end_byte) ? (0xFF >> (7 - (end_bit % 8))) : 0xFF;
+            mac ^= (buffer[i] & (lower_mask & upper_mask));
+            mac *= FNV_PRIME;
+        }
+    }
+    }
+    sim_t* sim;
+    spm_device_t* spm_device;
+    uint8_t buffer[64];
+    // レジスタ影
+    uint32_t spm_addr  = 0;   // SPMローカルオフセット
+    uint32_t start_bit = 0;   // 0..511
+    uint32_t end_bit   = 0;   // 0..511
+    uint64_t mac       = 0;   // MAC_RESULT
+    uint64_t command   = 0;   // 1=INIT, 2=UPDATE, 4=NOP
+    uint64_t start     = 0;   // SPM_START
+    uint64_t status = 0;
+    bool busy      = false;
+    size_t counter = 0;
+    std::queue<uint64_t> command_queue;
+    uint64_t exact_mac = 0;
+    uint16_t command_type = 0;
+    uint64_t complete_id = 0;
+    uint64_t req_id = 0;
+};
diff --git a/riscv/mmio_devices/memreq_device.h b/riscv/mmio_devices/memreq_device.h
new file mode 100644
index 00000000..b24de58c
--- /dev/null
+++ b/riscv/mmio_devices/memreq_device.h
@@ -0,0 +1,286 @@
+#pragma once
+#include "devices.h"
+#include "sim.h"
+#include "mmio_map.h"
+#include "axim_device.h"
+#include <vector>
+#include <cstring>
+#include <cstdint>
+#include <algorithm>
+#include <iostream>
+#include <cstring>
+#include <random>
+#include <map>
+#include <queue>
+#include <functional>
+
+
+
+struct request_trace{
+   uint64_t addr;
+   uint64_t is_write; // 1: write, 0: read
+};
+/*
+  memreq_device: AXI Master Interfaceを持ち、メモリに対してRead/Writeリクエストを発行する
+  - AXI Master Interfaceはaxim_mmio_device_tを通じて接続される
+  - レジスタインターフェースはmemreq_addrmap_tで定義される
+    - MEM_SIZE (0x00, W): メモリサイズ(Byte単位)
+    - NUM      (0x08, W): 転送回数(64B単位)
+  - 動作:
+    - NUMに値が書き込まれると、MEM_SIZEの範囲内でランダムに64Bアラインされたアドレスを選び、
+      そのアドレスに対してNUM回のWriteリクエストを発行し、その後同じアドレスに対してReadリクエストを発行する。
+    - 各Writeリクエストには簡単なデータパターンを書き込む。
+    - Readリクエストの応答が返ってきたら、書き込んだデータと比較し、一致すれば成功、不一致なら失敗とカウントする。
+    - 全てのReadリクエストの応答を受け取ったら、成功/失敗の集計結果を表示し、シミュレーションを終了する。
+  - Spikeからはtick()が周期的に呼ばれ、ここで1件ずつリクエストを発行していく。
+*/
+
+class memreq_mmio_device_t final : public abstract_device_t {
+public:
+  memreq_mmio_device_t(sim_t* sim, axim_mmio_device_t* axim)
+  : sim(sim), axim(axim) { }
+      // テスト操作を定義する内部構造
+    static constexpr uint64_t TRACE_DATA_BASE = 0x600000000;
+    struct TestOp {
+        enum class Type { Read, Write };
+        Type type;
+        uint64_t addr;
+        axim_mmio_device_t::DataBlock data; // Write時は書き込みデータ, Read時は期待データ
+    };
+    reg_t size() override { return memreq_addrmap_t::CTRL_SIZE; }
+    // MMIO read
+    bool load(reg_t addr, size_t len, uint8_t* bytes) override {
+        return false; // 読み不可
+    }
+    bool store(reg_t addr, size_t len, const uint8_t* bytes) override {
+        if (len != 8) return false;
+        uint64_t v; std::memcpy(&v, bytes, 8);
+        switch (addr) {
+            case memreq_addrmap_t::MEM_SIZE:  mem_size = v;   return true;
+            case memreq_addrmap_t::NUM:       {
+                init_final_memory_state();
+                if (v == 1) {
+                  make_request_trace();
+                  state = State::ISSUING;
+                  return true;
+                } else {
+                  num = v;
+                  make_request(); 
+                  state = State::ISSUING;
+                  return true;
+                }
+            }
+            default: return false; // 他は書き不可
+        }
+    }
+    // ★ Spike が周期的に呼ぶ：ここで1件ずつ発行していく
+  void tick(reg_t /*rtc_ticks*/) override {
+    switch (state) {
+      case State::IDLE:
+        return;
+      case State::ISSUING: {
+        if (inflight) return; // 応答待ち中なら何もしない
+        // 未発行＆キューが空 → outstanding も空ならDONEへ
+        if (m_test_queue.empty()) {
+          if (m_outstanding_requests.empty()) {
+            state = State::DONE;
+          }
+          return;
+        }
+        // リクエスト発行
+        // issue_some_requests(REQUESTS_PER_TICK);
+        // 次の1件だけ発行
+        TestOp op = m_test_queue.front(); m_test_queue.pop();
+        uint64_t req_id = issue_idx + 1;
+        inflight = true;
+        m_outstanding_requests[req_id] = op;
+        if (op.type == TestOp::Type::Write) {
+          axim->receiveLlcWriteRequest(
+            op.addr, req_id, op.data,
+            [this, req_id](bool ok){ onWriteAck(req_id, ok); }
+          );
+        } else {
+          axim->receiveLlcReadRequest(
+            op.addr, req_id,
+            [this, req_id](const axim_mmio_device_t::DataBlock& data){
+              onReadResponse(req_id, data);
+            }
+          );
+        }
+        issue_idx++;
+        return;
+    }
+      case State::DONE:
+        if (m_outstanding_requests.empty()) {
+          std::cout << "[MEMREQ] all responses received.\n";
+          std::cout << "[MEMREQ] Passed: " << m_passed_count << ", Failed: " << m_failed_count << "\n";
+          state = State::IDLE; // 再度IDLEに戻す
+          // exit(0); // テスト終了
+          // ダミーのリクエストを投げる
+          uint64_t end_signal = 0xFFFFFFFFFFFFFFFF;
+          axim->receiveLlcReadRequest(
+            end_signal, 0,
+            [](const axim_mmio_device_t::DataBlock&){
+              std::cout << "[MEMREQ] Testbench end signal received. Exiting simulation.\n";
+            }
+          );
+        }
+        return;
+    }
+}
+  
+
+private:
+    enum class State { IDLE, ISSUING, DONE };
+    // テストシナリオをキューに追加
+    void addWriteTest(uint64_t addr, const axim_mmio_device_t::DataBlock& data) {
+        m_test_queue.push({ TestOp::Type::Write, addr, data });
+    }
+    void addReadTest(uint64_t addr, const axim_mmio_device_t::DataBlock& expected_data) {
+        m_test_queue.push({ TestOp::Type::Read, addr, expected_data });
+    }
+    void make_request_trace(){
+        // メモリの初期化
+        std::cout << "\n[TB] Initializing memory for trace data...\n";
+        //memory traceの読み込み
+        request_trace req;
+        size_t count = 0;
+        axim_mmio_device_t::DataBlock w_data;
+        while (true){
+          std::cout << "{TB} trace address read at 0x" << std::hex << TRACE_DATA_BASE + count * sizeof(req) << std::dec << "\n";
+          sim->dma_read(TRACE_DATA_BASE + count * sizeof(req), sizeof(req), reinterpret_cast<uint8_t*>(&req));
+          if (req.addr == 0 && req.is_write == 0) {
+            // 次のトレースも一応読む
+            request_trace next_req;
+            sim->dma_read(TRACE_DATA_BASE + (count+1) * sizeof(req), sizeof(req), reinterpret_cast<uint8_t*>(&next_req));
+            if (next_req.addr == 0 && next_req.is_write == 0) {
+              break; // 終端条件
+            }
+            continue; // スキップ
+          }
+          std::cout << "[TB] Trace Request - Addr: 0x" << std::hex << req.addr << ", is_write: " << std::dec << req.is_write << "\n";
+          uint64_t addr = req.addr + 0x90000000;
+          if (req.is_write == 1){
+            // write request
+            for (size_t j=0;j<w_data.size();j++) w_data[j] = count + j; // 簡単なデータパターン
+            addWriteTest(addr, w_data);
+            final_memory_state[addr] = w_data; // 最終的にこのアドレスにはこのデータがあるはず
+          } else {
+            // read request
+            addReadTest(addr, final_memory_state[addr]);
+          }
+          count++;
+        }
+        total_expected_reqs = m_test_queue.size();
+        // uint64_t end_signal = 0xFFFFFFFFFFFFFFFF;
+        // addReadTest(end_signal, axim_mmio_device_t::DataBlock{}); // 終了シグナル
+      }
+    void init_final_memory_state(){
+        for (size_t i=0;i<mem_size/64;i++){
+          // if (i % (2048 * 2048) == 0) {
+          //   std::cout << "[TB] Initializing final memory state at block " << i << "\n";
+          // } // trace data領域はスキップ
+          axim_mmio_device_t::DataBlock zero_block;
+          for (size_t j=0;j<zero_block.size();j++) zero_block[j] = i; // 簡単なデータパターン
+          // for (size_t j=0;j<zero_block.size();j++) {
+          //   std::cout << std::hex << static_cast<int>(zero_block[j]) << " ";
+          // }
+          // std::cout << std::dec << "\n";
+          uint64_t addr = i * 64 + 0x90000000;
+          final_memory_state[addr] = zero_block; // 最終的にこのアドレスにはこのデータがあるはず
+        }
+    } 
+    void make_request(){
+        std::random_device rd;
+        std::mt19937 gen(rd());
+        std::uniform_int_distribution<uint32_t> addr_dist(0, num - 1); // 64Bアラインされたアドレス範囲
+        std::cout << "\n[TB] Generating " << num << " test cases...\n";
+        std::vector<std::pair<uint64_t, axim_mmio_device_t::DataBlock>> test_plan;
+        uint64_t mem_blocks = mem_size / num;
+        mem_blocks = mem_blocks & ~0x3F; // 64Bアライン
+        mem_blocks = std::max<uint64_t>(mem_blocks, 64);
+        // for (uint64_t i = 0; i < num; ++i) {
+        //   uint64_t addr = i * mem_blocks + 0x90000000;
+        //   axim_mmio_device_t::DataBlock data;
+        //   for(size_t j=0; j<data.size(); ++j) data[j] = i+j; // 簡単なデータパターン
+        //   test_plan.push_back({addr, data});
+        //   final_memory_state[addr] = data; // 最終的にこのアドレスにはこのデータがあるはず
+        // }
+        // write
+        // for (const auto& test_case : test_plan) {
+        //     addWriteTest(test_case.first, test_case.second);
+        // }
+        std::vector<std::pair<uint64_t, axim_mmio_device_t::DataBlock>> test_random_plan;
+        for (uint64_t i = 0; i < num; ++i) {
+          uint64_t j = addr_dist(gen);
+          uint64_t addr = j * mem_blocks + 0x90000000;
+          // uint64_t is_write = addr_dist(gen) % 2;
+          axim_mmio_device_t::DataBlock data;
+          if (false) {
+            data = final_memory_state[addr];
+            addReadTest(addr, data);
+          } 
+          else {
+              for(size_t j=0; j<data.size(); ++j) data[j] = 2 *(i+j); // 簡単なデータパターン
+              final_memory_state[addr] = data; // 最終的にこのアドレスにはこのデータがあるはず
+              addWriteTest(addr, data);
+          }
+          // test_plan.push_back({addr, data});
+        }
+        total_expected_reqs = m_test_queue.size();
+    }
+    // Writeリクエストのコールバック
+    void onWriteAck(uint64_t req_id, bool success) {
+        std::cout << "[TB] Write Ack received for ID " << req_id << ".\n";
+        if (success) {
+            m_passed_count++;
+        } else {
+            m_failed_count++;
+        }
+        m_outstanding_requests.erase(req_id);
+        inflight = false;
+    }
+
+    // Readリクエストのコールバック
+    void onReadResponse(uint64_t req_id, const axim_mmio_device_t::DataBlock& received_data) {
+        std::cout << "[TB] Read Response received for ID " << req_id << ".\n";
+        auto it = m_outstanding_requests.find(req_id);
+        if (it != m_outstanding_requests.end()) {
+            if (it->second.data == received_data) {
+                std::cout << "  ✅ Data matches expected value.\n";
+                m_passed_count++;
+            } else {
+                std::cout << "  ❌ Data MISMATCH!\n";
+                std::cout << "  Expected: ";
+                for (const auto& byte : it->second.data) {
+                    std::cout << std::hex << static_cast<int>(byte) << " ";
+                }
+                std::cout << "\n  Received: ";
+                for (const auto& byte : received_data) {
+                    std::cout << std::hex << static_cast<int>(byte) << " ";
+                }
+                std::cout << std::dec << "\n";
+                m_failed_count++;
+            }
+            m_outstanding_requests.erase(it);
+            inflight = false;
+        }
+    }
+    sim_t* sim;
+    axim_mmio_device_t* axim;
+    // 発行ステート
+    State state = State::IDLE;
+
+    std::map<uint64_t, axim_mmio_device_t::DataBlock> final_memory_state; // 期待される最終メモリ状態
+    size_t issue_idx = 0;
+    static constexpr size_t REQUESTS_PER_TICK = 4; // 1 tickあたりの発行数
+    std::queue<TestOp> m_test_queue;
+    std::map<uint64_t, TestOp> m_outstanding_requests;
+    // レジスタ影
+    uint64_t num = 0;         // 転送回数
+    uint64_t mem_size = 0; // Byte単位
+    int m_passed_count = 0;
+    int m_failed_count = 0;
+    uint64_t total_expected_reqs = 0;
+    bool inflight = false; // 応答待ち中か
+};
diff --git a/riscv/mmio_devices/mmio_map.h b/riscv/mmio_devices/mmio_map.h
