diff --git a/riscv/mmio_devices/aes128.h b/riscv/mmio_devices/aes128.h
new file mode 100644
index 00000000..f701add7
--- /dev/null
+++ b/riscv/mmio_devices/aes128.h
@@ -0,0 +1,177 @@
+#pragma once
+#include <array>
+#include <cstdint>
+#include <cstring>
+
+namespace aes {
+
+/** 128-bit AES block */
+using Block = std::array<uint8_t, 16>;
+
+/** AES-128 encryptor (10 rounds, full key schedule). */
+class AES128 {
+public:
+  AES128() = default;
+  explicit AES128(const Block& key) { set_key(key); }
+
+  void set_key(const Block& key) {
+    key_sched_[0] = key;           // round key 0 (original key)
+    expand_key();                  // fill key_sched_[1..10]
+  }
+
+  /** Encrypt one 16-byte block (in -> out). */
+  Block encrypt_block(const Block& in) const {
+    State s{};
+    // load state in column-major (AES standard)
+    for (int i = 0; i < 16; ++i) s[i % 4][i / 4] = in[i];
+
+    add_round_key(s, key_sched_[0]);
+    for (int r = 1; r < 10; ++r) {
+      sub_bytes(s);
+      shift_rows(s);
+      mix_columns(s);
+      add_round_key(s, key_sched_[r]);
+    }
+    sub_bytes(s);
+    shift_rows(s);
+    add_round_key(s, key_sched_[10]);
+
+    Block out{};
+    for (int i = 0; i < 16; ++i) out[i] = s[i % 4][i / 4];
+    return out;
+  }
+
+private:
+  using State = std::array<std::array<uint8_t,4>,4>;
+  std::array<Block, 11> key_sched_{}; // round keys K0..K10
+
+  // S-box (AES spec)
+  static constexpr uint8_t sbox_[256] = {
+    0x63,0x7c,0x77,0x7b,0xf2,0x6b,0x6f,0xc5,0x30,0x01,0x67,0x2b,0xfe,0xd7,0xab,0x76,
+    0xca,0x82,0xc9,0x7d,0xfa,0x59,0x47,0xf0,0xad,0xd4,0xa2,0xaf,0x9c,0xa4,0x72,0xc0,
