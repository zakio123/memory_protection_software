+// --- 1. ここに「巨大な配列」＝ 期待値モデル を定義 ---
+// アドレス (64Bアライメント) をキーとし、データブロックを値とする
+static std::map<uint64_t, axim_mmio_device_t::DataBlock> g_golden_memory_model;
+static std::map<uint64_t, axim_mmio_device_t::DataBlock> outstanding_requests_data;
+
+static sim_t* g_sim = nullptr;
+void onWriteAck(spike_memory_packet_t packet, bool success) {
+    // std::cout << "[TB] Write Ack received for ID " << packet.id << ".\n";
+    g_sim->spike_completion_mutex.lock();
+    g_sim->spike_completion_queue.push(packet);
+    g_sim->spike_completion_mutex.unlock();
+    if (success) {
+      // Champsim側のラッパー関数を呼び出す
+    } else {
+        std::cout << "  ❌ Write FAILED!\n";
+    }
+}
+
+// Readリクエストのコールバック
+void onReadResponse(spike_memory_packet_t packet, const axim_mmio_device_t::DataBlock& received_data, const axim_mmio_device_t::DataBlock& expected_data) {
+    // std::cout << "[TB] Read Response received for ID " << packet.id << ".\n";
+    // auto it = outstanding_requests_data.find(packet.id);
+    bool match= true;
+    for(size_t i=0;i<received_data.size();i++){
+        if(received_data[i]!=expected_data[i]){
+            match = false;
+            break;
+        }
+    }
+    g_sim->spike_completion_mutex.lock();
+    g_sim->spike_completion_queue.push(packet);
+    g_sim->spike_completion_mutex.unlock();
+    if(match){
+        // std::cout << "  ✅ Data matches expected value.\n";
+        return;
+    }else{
+        std::cout << "[TB] Read Data MISMATCH for ID " << packet.id << "!\n";
+        std::cout << " address 0x" << std::hex << packet.addr << std::dec << "\n";
+        std::cout << "  ❌ Data MISMATCH!\n";
+        std::cout << "  Expected: ";
+        for (const auto& byte : expected_data) {
+            std::cout << std::hex << static_cast<int>(byte) << " ";
+        }
+        std::cout << "\n  Received: ";
+        for (const auto& byte : received_data) {
+            std::cout << std::hex << static_cast<int>(byte) << " ";
+        }
+        std::cout << std::dec << "\n";
+        return;
+    }
+}
