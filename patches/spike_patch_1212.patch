diff --git a/riscv/mmio_devices/spm_device.h b/riscv/mmio_devices/spm_device.h
new file mode 100644
index 00000000..b4f40c49
--- /dev/null
+++ b/riscv/mmio_devices/spm_device.h
@@ -0,0 +1,343 @@
+#pragma once
+#include "devices.h"
+#include "sim.h"
+#include "mmio_devices/mmio_map.h"
+#include "mmio_devices/setting.h"
+
+// #include "mmio_devices/settings.h"
+#include <vector>
+#include <cstring>
+#include <cstdint>
+#include <algorithm>
+
+// load/storeで制御されるのは、external dmaのみ。
+class spm_device_t final : public abstract_device_t {
+public:
+  spm_device_t(sim_t* sim)
+  : sim(sim), spm_buf(spm_addrmap_t::MEM_SIZE, 0), completion_bitmap(WINDOW_SIZE, false), // 1024ビットのビットマップをすべて0(false)に
+  completed_id(0)
+   {}
+
+  ~spm_device_t() override {
+  std::cout << "[SPM] DRAM DMA stats: "
+            << "reads=" << dram_dma_reads
+            // << " (" << dram_dma_read_bytes  << " bytes), "
+            << "writes=" << dram_dma_writes
+            // << " (" << dram_dma_write_bytes << " bytes)"
+            << std::endl;
+  }
+  reg_t size() override { return spm_addrmap_t::TOTAL_SIZE; }
+
+  // MMIO read
+  bool load(reg_t addr, size_t len, uint8_t* bytes) override {
+    if (addr < spm_addrmap_t::MEM_SIZE) {
+      // SPM データ窓
+      reg_t off = addr;
+      if (off + len > spm_buf.size()) {
+        std::cout << "[SPM] load out of bounds" << std::endl;
+        return false;
+      }
+      std::memcpy(bytes, &spm_buf[off], 8);
+      return true;
+    } else {
+      // レジスタ空間（64bitのみ許可）
+      if (len != 8) return false;
+      reg_t off = addr - spm_addrmap_t::CTRL_BASE_OFF;
+      uint64_t v = 0;
+      switch (off) {
+        // case spm_addrmap_t::REG_DRAM_ADDR:  v = dram_addr;  break;
+        // case spm_addrmap_t::REG_LOCAL_ADDR: v = local_addr; break;
+        // case spm_addrmap_t::REG_SIZE:       v = xfer_size;  break;
+        // case spm_addrmap_t::REG_DIRECTION:  v = direction;  break;
+        case spm_addrmap_t::REG_START:      v = busy ? 1ULL : 0ULL; break;
+        case spm_addrmap_t::REG_COMPLETE_ID : v = completed_id; break;
+        default: return false;
+      }
+      std::memcpy(bytes, &v, 8);
+      return true;
+    }
+  }
+
+  // MMIO write
+  bool store(reg_t addr, size_t len, const uint8_t* bytes) override {
+    if (addr < spm_addrmap_t::MEM_SIZE) {
+      // SPM データ窓
+      reg_t off = addr - spm_addrmap_t::MEM_BASE_OFF;
+      if (off + len > spm_buf.size()) return false;
+      std::memcpy(&spm_buf[off], bytes, len);
+      return true;
+    } else {
+      // レジスタ空間（64bitのみ許可）
+      if (len != 8) return false;
+      reg_t off = addr - spm_addrmap_t::CTRL_BASE_OFF;
+      uint64_t v; std::memcpy(&v, bytes, 8);
+      switch (off) {
+        case spm_addrmap_t::REG_DRAM_ADDR:  dram_addr  = v; return true;
+        case spm_addrmap_t::REG_LOCAL_ADDR: local_addr = v; return true; // SPM先頭からの相対
+        case spm_addrmap_t::REG_SIZE:       xfer_size  = v; return true;
+        case spm_addrmap_t::REG_DIRECTION:  direction  = v & 1ULL; return true;
+        case spm_addrmap_t::REG_DESTINATION: {destination = v;return true;}
+        case spm_addrmap_t::REG_START:
+          if ((v & 1ULL) && !busy) {
+            // // DRAM系
+            // if (destination == 1) {
+            //   start_dram_dma();
+            // }
+            // else {
+            //   // その他
+            //   start_other_dma();
+            // }
+            start_dram_dma();
+            return true;
+          }
+        case spm_addrmap_t::REG_ID: process_id = v; return true;
+          default: return false;
+      }
+    }
+  }
+  void tick(reg_t /*rtc_ticks*/) override {
+  }
+
+  // bool copy_spm_to_mac(reg_t local_addr){
+  //   uint8_t buf[64];
+  //   // SPMデータ窓から読み込み
+  //   memcpy(buf, &spm_buf[local_addr], 64);
+  //   // MAC に 64B 書き込み
+  //   if(!mac->write(buf)) return false;
+  //   return true;
+  // }
+  
+  // bool copy_xor_to_spm(reg_t local_addr){
+  //   uint8_t buf[64];
+  //   // XOR から 64B 読み込み
+  //   if(!xored->copy(buf)) return false;
+  //   // SPMデータ窓に書き込み
+  //   memcpy(&spm_buf[local_addr], buf, 64);
+  //   return true;
+  // }
+  // bool copy_spm_to_xor(reg_t local_addr){
+  //   uint8_t buf[64];
+  //   // SPMデータ窓から読み込み
+  //   memcpy(buf, &spm_buf[local_addr], 64);
+  //   // XOR に 64B 書き込み
+  //   if(!xored->write(buf)) return false;
+  //   return true;
+  // }
+
+
+  // 外部のデータをSPMにコピー
+  void copy(reg_t dest_addr, const uint8_t* src, size_t len){
+    if (dest_addr + len > spm_buf.size()) {
+      std::cout << "[SPM] copy out of bounds" << std::endl;
+      return;
+    }
+    std::memcpy(&spm_buf[dest_addr], src, len);
+  }
+  // SPMのデータを外部にコピー
+  void write(reg_t src_addr, uint8_t* dst, size_t len){
+    if (src_addr + len > spm_buf.size()) {
+      std::cout << "[SPM] write out of bounds" << std::endl;
+      return;
+    }
+    std::memcpy(dst, &spm_buf[src_addr], len);
+  }
+
+
+private:
+  void notify_completion(uint64_t id){
+    // 1. IDが古すぎるかチェック (すでにハイ・ウォーター・マークより下)
+    if (id <= completed_id) {
+        std::cout << "[SPM] Ignoring old ID: " << id << " (completed_id is " << completed_id << ")\n";
+        return; // 古いIDは無視
+    }
+    // 2. IDがウィンドウの範囲外（新しすぎ）でないかチェック
+    if (id >= completed_id + WINDOW_SIZE) {
+        // これは設計上のエラー。ウィンドウサイズが小さすぎるか、CPUがIDを発行しすぎている。
+        std::cerr << "[SPM] FATAL ERROR: ID " << id << " is out of window range!" << std::endl;
+        std::cerr << "  completed_id: " << completed_id << ", WINDOW_SIZE: " << WINDOW_SIZE << std::endl;
+        // (ここではエラー処理として無視する)
+        return;
+    }
+    // 3. ビットマップ上のインデックスを計算 (リングバッファ)
+    size_t idx_in_window = id % WINDOW_SIZE;
+    // 4. ビットマップをセット
+    if (completion_bitmap[idx_in_window]) {
+        std::cout << "[SPM] Warning: ID " << id << " was already completed.\n";
+    }
+    completion_bitmap[idx_in_window] = true;
+    // 5. ハイ・ウォーター・マーク（completed_id）の更新 (スキャン)
+    //    現在の完了IDの「次」からスキャンを開始
+    uint64_t scan_id = completed_id + 1;
+    size_t scan_idx = scan_id % WINDOW_SIZE;
+
+    // ビットマップがtrueである限り、スキャンを進める
+    while (completion_bitmap[scan_idx] == true) {
+        // (A) ビットをクリア（スロットを再利用可能にする）
+        completion_bitmap[scan_idx] = false;
+        // (B) ハイ・ウォーター・マークを更新
+        completed_id = scan_id;
+        // (C) 次のIDをスキャン
+        scan_id++;
+        scan_idx = scan_id % WINDOW_SIZE;
+    }
+    return;
+    // ループ終了。completed_id は連続完了の最大IDを指す。
+  }
+  // void start_other_dma() {
+    // local_addr は SPMデータ窓の先頭からのバイトオフセット（相対）
+  //   if (local_addr + xfer_size > spm_buf.size()) {
+  //     status |= 1ULL; // ERR_OOB
+  //     busy = false;
+  //     return;
+  //   }
+  //   bool ok;
+  //   if (destination & 4) {// AXIManager
+  //     if (direction == 0) ok = copy_aximanager_to_spm(local_addr);
+  //     else {ok = copy_spm_to_aximanager(local_addr);}
+  //   } else if (destination & 2){
+  //     if (direction == 0) ok = false; // MAC -> SPM はしない
+  //     else ok = copy_spm_to_mac(local_addr);
+  //   } else if (destination & 8) { // XOR
+  //     if (direction == 0) ok = copy_xor_to_spm(local_addr);
+  //     else ok = copy_spm_to_xor(local_addr);
+  //   }else {
+  //     ok = false;
+  //   }
+  //   if (!ok) status |= (1ULL << 1); // ERR_BUS
+  //   return ;
+  // } 
+  
+  void start_dram_dma(){
+    // local_addr は SPMデータ窓の先頭からのバイトオフセット（相対）
+    if (local_addr + xfer_size > spm_buf.size()) {
+      status |= 1ULL; // ERR_OOB
+      return;
+    }
+    bool ok;
+    // busy = true; // DMA開始
+    if (direction == 0) {
+      // DRAM -> SPM
+      uint64_t id = this->process_id;
+      uint64_t d = dram_addr;
+      uint64_t l = local_addr;
+      uint64_t s = xfer_size;
+      // (thisポインタをキャプチャするラムダ式)
+      auto read_cb = [this,id,d,l,s](){
+          // データをSPMバッファにコピー
+          copy_dram_to_spm(d, l, s);
+          // ★ コールバック内で busy を解除
+          this->notify_completion(id);
+      };
+      ok = sim->external_dma_read(dram_addr, xfer_size, read_cb, id);
+    } else {
+      // SPM -> DRAM
+      uint64_t id = this->process_id;
+      uint64_t d = dram_addr;
+      uint64_t l = local_addr;
+      uint64_t s = xfer_size;
+      auto write_cb = [this,id,d,l,s]{
+          copy_spm_to_dram(l, d, s);
+      };
+      ok = sim->external_dma_write(dram_addr, xfer_size,write_cb, id);
+    }
+    if (!ok) {
+        status |= (1ULL << 1); // ERR_BUS
+        busy = false; // 失敗したので busy 解除
+    }
+    // 完了はコールバックが処理する。
+    return ;
+  }
+
+  bool copy_dram_to_spm(reg_t src_pa, reg_t dst_spm_off, uint64_t len) {
+    reg_t pa = src_pa; reg_t off = dst_spm_off; uint64_t left = len;
+    dram_dma_reads++;
+    while (left) {
+      if (left >= 8 && ((pa & 7) == 0) && ((off & 7) == 0)) {
+        uint8_t buf[8];
+        if (!sim->dma_read(pa, 8, buf)) return false;
+        std::memcpy(&spm_buf[off], buf, 8);
+        pa += 8; off += 8; left -= 8;
+      } else {
+        uint8_t b;
+        if (!sim->dma_read(pa, 1, &b)) return false;
+        spm_buf[off] = b;
+        pa += 1; off += 1; left -= 1;
+      }
+    }
+    return true;
+  }
+
+  bool copy_spm_to_dram(reg_t src_spm_off, reg_t dst_pa, uint64_t len) {
+    reg_t pa = dst_pa; reg_t off = src_spm_off; uint64_t left = len;
+    dram_dma_writes++;
+    while (left) {
+      if (left >= 8 && ((pa & 7) == 0) && ((off & 7) == 0)) {
+        uint8_t buf[8];
+        std::memcpy(buf, &spm_buf[off], 8);
+        if (!sim->dma_write(pa, 8, buf)) return false;
+        pa += 8; off += 8; left -= 8;
+      } else {
+        uint8_t b = spm_buf[off];
+        if (!sim->dma_write(pa, 1, &b)) return false;
+        pa += 1; off += 1; left -= 1;
+      }
+    }
+    return true;
+  }
+
+  // bool copy_aximanager_to_spm(reg_t spm_addr){
+  //   uint8_t buf[64];
+  //   // AXIManager から 64B 読み込み
+  //   if(!axim->copy(buf)) return false;
+  //   // SPMデータ窓に書き込み
+  //   memcpy(&spm_buf[spm_addr], buf, 64);
+  //   return true;
+  // }
+  
+  // bool copy_spm_to_aximanager(reg_t local_addr){
+  //   uint8_t buf[64];
+  //   // SPMデータ窓から読み込み
+  //   memcpy(buf, &spm_buf[local_addr], 64);
+  //   // AXIManager に 64B 書き込み
+  //   if(!axim->write(buf)) return false;
+  //   return true;
+  // }
+
+
+  private:
+  enum class State { IDLE, ISSUING, DONE };
+  State state = State::IDLE;
+  sim_t* sim;
+  std::vector<uint8_t> spm_buf;
+  // 64bitレジスタ
+  uint64_t dram_addr  = 0;
+  uint64_t local_addr = 0; // SPMデータ窓先頭からの相対（バイト）
+  uint64_t xfer_size  = 0;
+  uint64_t direction  = 0; // 0/1
+  uint64_t status     = 0;
+  uint64_t destination = 0; // 1:DRAM 2:MAC, 4:AXIManager  (OR可)
+  uint64_t dram_dma_reads;
+  uint64_t dram_dma_writes;
+  size_t counter = 0;
+  /**
+   * @brief 完了追跡ウィンドウのサイズ (ID数)。
+   * @note リングバッファとして機能するため、2のべき乗である必要はないが、
+   * モジュロ演算（%）の効率のため、実ハードウェアでは2のべき乗が好まれる。
+   */
+  const static size_t WINDOW_SIZE = 1024;
+
+  /**
+   * @brief Out-of-Order完了を追跡するビットマップ (リングバッファ)。
+   * completion_bitmap[id % WINDOW_SIZE] == true なら、ID 'id' は完了している。
+   */
+  std::vector<bool> completion_bitmap ;
+
+  /**
+   * @brief CPUに公開する「連続完了ID」（ハイ・ウォーター・マーク）。
+   * ID 0 からこのIDまでのすべてのタスクが完了したことを保証する。
+   * (MMIOレジスタ REG_COMPLETE_ID の実体)
+   */
+  uint64_t completed_id;
+  uint64_t process_id = 0;
+  bool busy = false;
+};
diff --git a/riscv/mmio_devices/stack_device.h b/riscv/mmio_devices/stack_device.h
new file mode 100644
index 00000000..aa9cfdd5
--- /dev/null
+++ b/riscv/mmio_devices/stack_device.h
@@ -0,0 +1,61 @@
+#pragma once
+#include "devices.h"
+#include "sim.h"
+#include "mmio_devices/mmio_map.h"
+#include <vector>
+#include <cstring>
+#include <cstdint>
+#include <algorithm>
+
+
+
+class stack_device_t final : public abstract_device_t {
+public:
+  stack_device_t(sim_t* sim)
+  : sim(sim), stack_buf(stack_addrmap_t::MEM_SIZE, 0) {}
+
+  reg_t size() override { return stack_addrmap_t::MEM_SIZE; }
+
+  // MMIO read
+  bool load(reg_t addr, size_t len, uint8_t* bytes) override {
+    // std::cout << "stack_device_t::load addr=0x" << std::hex << addr << " len=" << std::dec << len << std::endl;
+    if (addr < stack_addrmap_t::MEM_SIZE) {
+      // レジスタ空間（64bitのみ許可）
+        if ((len != 8) && (len != 4) && (len != 1) ) return false;
+        memcpy(bytes, &stack_buf[addr], len);
+        return true;
+    } else {
+        return false;
+    }
+  }
+
+  // MMIO write
+  bool store(reg_t addr, size_t len, const uint8_t* bytes) override {
+    // std::cout << "stack_device_t::store addr=0x" << std::hex << addr << " len=" << std::dec << len << std::endl;
+    if (addr < stack_addrmap_t::MEM_SIZE) {
+      // レジスタ空間（64bitのみ許可）
+        if ((len != 8) && (len != 4) && (len != 1) ) return false;
+        memcpy(&stack_buf[addr], bytes, len);
+        return true;
+    } else {
+        return false;
+    }
+  }
+  void tick(reg_t /*rtc_ticks*/) override {
+    // 同期完了版：何もしない
+    // 非同期にしたいなら busy=true の間ここで少しずつ copy して最後に busy=false
+  }
+
+private:
+  sim_t* sim;
+  std::vector<uint8_t> stack_buf;
+
+  // 64bitレジスタ
+  uint64_t dram_addr  = 0;
+  uint64_t local_addr = 0; // SPMデータ窓先頭からの相対（バイト）
+  uint64_t xfer_size  = 0;
+  uint64_t direction  = 0; // 0/1
+  uint64_t status     = 0;
+
+  bool busy = false;
+};
diff --git a/riscv/mmio_devices/xor_device.h b/riscv/mmio_devices/xor_device.h
