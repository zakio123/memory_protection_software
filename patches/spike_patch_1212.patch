+  static inline uint8_t xtime(uint8_t x) {
+    return (uint8_t)((x << 1) ^ ((x & 0x80) ? 0x1b : 0x00));
+  }
+  static inline uint8_t mul(uint8_t x, uint8_t y) {
+    // multiply in GF(2^8) with AES polynomial
+    uint8_t r = 0;
+    while (y) {
+      if (y & 1) r ^= x;
+      x = xtime(x);
+      y >>= 1;
+    }
+    return r;
+  }
+
+  static void sub_bytes(State& s) {
+    for (int r = 0; r < 4; ++r)
+      for (int c = 0; c < 4; ++c)
+        s[r][c] = sbox_[s[r][c]];
+  }
+
+  static void shift_rows(State& s) {
+    // row 1: left shift by 1
+    uint8_t t = s[1][0];
+    s[1][0] = s[1][1]; s[1][1] = s[1][2]; s[1][2] = s[1][3]; s[1][3] = t;
+    // row 2: left shift by 2
+    std::swap(s[2][0], s[2][2]); std::swap(s[2][1], s[2][3]);
+    // row 3: left shift by 3
+    t = s[3][0];
+    s[3][0] = s[3][1]; s[3][1] = s[3][2]; s[3][2] = s[3][3]; s[3][3] = t;
+  }
+
+  static void mix_columns(State& s) {
+    for (int c = 0; c < 4; ++c) {
+      uint8_t a0 = s[0][c], a1 = s[1][c], a2 = s[2][c], a3 = s[3][c];
+      s[0][c] = (uint8_t)(mul(0x02, a0) ^ mul(0x03, a1) ^ a2 ^ a3);
+      s[1][c] = (uint8_t)(a0 ^ mul(0x02, a1) ^ mul(0x03, a2) ^ a3);
+      s[2][c] = (uint8_t)(a0 ^ a1 ^ mul(0x02, a2) ^ mul(0x03, a3));
+      s[3][c] = (uint8_t)(mul(0x03, a0) ^ a1 ^ a2 ^ mul(0x02, a3));
+    }
+  }
+
+  static void add_round_key(State& s, const Block& rk) {
+    // rk is in column-major order (4 bytes per column)
+    for (int i = 0; i < 16; ++i)
+      s[i % 4][i / 4] ^= rk[i];
+  }
+
+  static uint8_t sub_byte(uint8_t v) { return sbox_[v]; }
+
+  static void key_core(uint8_t* w, uint8_t rcon) {
+    // rotate left
+    uint8_t t = w[0]; w[0] = w[1]; w[1] = w[2]; w[2] = w[3]; w[3] = t;
+    // sub bytes
+    w[0] = sub_byte(w[0]);
+    w[1] = sub_byte(w[1]);
+    w[2] = sub_byte(w[2]);
+    w[3] = sub_byte(w[3]);
+    // add rcon to first byte
+    w[0] ^= rcon;
+  }
+
+  void expand_key() {
+    // AES-128 key schedule generates 11 round keys (16 bytes each)
+    // key_sched_[0] is already filled (original key)
+    uint8_t w[176]; // 11 * 16
+    std::memcpy(w, key_sched_[0].data(), 16);
+
+    int bytes_gen = 16;
+    int rcon_idx = 0;
+    uint8_t temp[4];
+
+    while (bytes_gen < 176) {
+      for (int i = 0; i < 4; ++i) temp[i] = w[bytes_gen - 4 + i];
+
+      if (bytes_gen % 16 == 0) {
+        key_core(temp, Rcon_[rcon_idx++]);
+      }
+      for (int i = 0; i < 4; ++i) {
+        w[bytes_gen] = (uint8_t)(w[bytes_gen - 16] ^ temp[i]);
+        ++bytes_gen;
+      }
+    }
+
+    for (int r = 1; r <= 10; ++r) {
+      std::memcpy(key_sched_[r].data(), w + r * 16, 16);
+    }
+  }
+};
