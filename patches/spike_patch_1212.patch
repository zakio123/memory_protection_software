+static unsigned long atoul_safe(const char* s)
+{
+  char* e;
+  auto res = strtoul(s, &e, 10);
+  if (*e)
+    // help();
+  return res;
+}
+
+static unsigned long atoul_nonzero_safe(const char* s)
+{
+  auto res = atoul_safe(s);
+  if (!res)
+    // help();
+  return res;
+}
