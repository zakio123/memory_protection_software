+axim_mmio_device_t::DataBlock& get_golden_data_lazy(uint64_t addr) {
+    auto it = g_golden_memory_model.find(addr);
+    if (it == g_golden_memory_model.end()) {
+        // データが存在しない場合 (初回アクセス時)
+        axim_mmio_device_t::DataBlock block;
+        
+        // 初期値の生成ロジック
+        // 例: アドレスに基づいたパターンや、以前の初期化ループと同じロジックをここで適用
+        // (以前のループ: i はブロックインデックス相当と仮定)
+        uint64_t base_addr = 0x90000000ULL;
+        size_t i = (addr >= base_addr) ? (addr - base_addr) / 64 : 0;
+        
+        std::memset(block.data(),
+                    static_cast<unsigned char>(i),  // 1byte パターン
+                    block.size());
+        
+        // 新しいエントリをマップに挿入
+        // operator[] はデフォルトコンストラクタを呼ぶため、明示的に作成したblockを入れる
+        g_golden_memory_model[addr] = block;
+        return g_golden_memory_model[addr];
+    }
+    // 既に存在する場合
+    return it->second;
+}
+bool spike_axim_llc_read_req(spike_memory_packet_t packet){
+    if (!g_sim) return false;
+    // ステップ1で実装した sim->get_axim_dev() を呼び出す
+    axim_mmio_device_t* axim = g_sim->get_axim_device(); 
+    if (!axim) return false;
+    // C言語のコールバック (void*, func_ptr) を C++ の std::function にラップする
+    // axim_mmio_device_t::DataBlock expected_data;
+    axim_mmio_device_t::DataBlock expected_data = get_golden_data_lazy(packet.addr);
+    auto read_cb = [packet,expected_data](const axim_mmio_device_t::DataBlock& received_data){
+        onReadResponse(packet, received_data,expected_data);
+    };
+    return axim->receiveLlcReadRequest(packet.addr, packet.id, read_cb);
+}
+bool spike_axim_llc_write_req(spike_memory_packet_t packet){
+    if (!g_sim) return false;
+    axim_mmio_device_t* axim = g_sim->get_axim_device();
+    if (!axim) return false;
+    // 期待値を更新
+    axim_mmio_device_t::DataBlock data;
+    // 一旦コピー
+    std::memcpy(data.data(), g_golden_memory_model[packet.addr].data(), sizeof(data.size()));
+    // データを更新
+    for (size_t i=0;i<sizeof(data.size());i++){
+        data[i] +=1;
+    }
+    g_golden_memory_model[packet.addr] = data;
+    // C言語のコールバック (void*, func_ptr) を C++ の std::function にラップする
+    return axim->receiveLlcWriteRequest(packet.addr, packet.id, data,[packet](bool ok){ onWriteAck(packet, ok); });
+}
