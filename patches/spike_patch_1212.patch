--- /dev/null
+++ b/riscv/mmio_devices/xor_device.h
@@ -0,0 +1,157 @@
+#pragma once
+#include "devices.h"
+#include "sim.h"
+#include "mmio_map.h"
+#include "axim_device.h"
+#include "spm_device.h"
+#include <vector>
+#include <cstring>
+#include <cstdint>
+#include <algorithm>
+#include <queue>
+#include <array>
+#include <functional>
+
+class xor_mmio_device_t final : public abstract_device_t {
+public:
+  xor_mmio_device_t(sim_t* sim,axim_mmio_device_t* axim_device, spm_device_t* spm_device) : sim(sim), axim_device(axim_device), spm_device(spm_device) {}
+
+    // AESからOTPを受け取るための型定義
+    using Otp = std::array<uint8_t, 16>; // 128bit
+    using DataBlock = std::array<uint8_t, 64>; // 512bit
+    void pushOtpToFifo(const Otp& otp) {
+        m_otp_fifo.push(otp);
+    }
+    reg_t size() override { return axim_addrmap_t::CTRL_SIZE; }
+
+    // MMIO read
+    bool load(reg_t addr, size_t len, uint8_t* bytes) override {
+        // std::cout << "[AXIM HW] MMIO Load from addr 0x" << std::hex << addr << std::dec << "\n";
+        if (len != 8) return false;
+        uint64_t v = 0;
+        switch (addr) {
+            case xor_addrmap_t::START: {
+                v = m_start_reg;
+                break;
+            }
+            default: return false; // 他は読み不可
+        }
+        std::memcpy(bytes, &v, 8);
+        return true;
+    }
+    bool store(reg_t addr, size_t len, const uint8_t* bytes) override {
+        if (len != 8) return false;
+        uint64_t v; std::memcpy(&v, bytes, 8);
+        if (addr == xor_addrmap_t::START) {
+            if (v != 0) {
+                m_start_reg = v;      // busy
+                if ((v & 2) == 0){
+                    input_direction = false; // from SPM
+                } else {
+                    input_direction = true; // from Req I/O
+                }
+                if ((v & 4) == 0){
+                    output_direction = false; // to SPM
+                } else {
+                    output_direction = true; // to Req I/O
+                }
+                spm_offset = ((v & 0xFFFFFFFF) >> 3);
+                req_id = (v >> 32) & 0xFFFFFF;
+            }
+            else {
+                m_start_reg = 0; // idle
+            }
+            return true;
+        } else {
+            return false; // 他は書き不可
+        }
+        return true;
+    }
+    void tick(reg_t /*rtc_ticks*/) override {
+        if (m_start_reg != 0) {
+            if (input_direction == false){
+                // SPMから読み込み
+                spm_device->write(spm_offset, input_data.data(), 64);
+            }
+            for (size_t j = 0; j < 4; ++j) { // 64Bを16Bずつ4回に分けて処理
+                if (!m_otp_fifo.empty()) {
+                    auto otp_part = m_otp_fifo.front(); m_otp_fifo.pop();
+                    if (input_direction == false) {
+                        // SPMから読み込み
+                        for(size_t i=0; i<16; ++i) output_data[j*16+i] = otp_part[i] ^ input_data[j*16+i];                    
+                    } else { // from Req I/O
+                        auto data = axim_device->write_data_pop(req_id, j);
+                        for (size_t i = 0; i < 16; ++i) {
+                            output_data[j * 16 + i] = otp_part[i] ^ data[i];
+                        }
+                    }
+                    if (output_direction == true){
+                        // XOR結果をReq I/Oへ返す
+                        Otp chunk;
+                        for (size_t i = 0; i <16; ++i){
+                            chunk[i] = output_data[j*16 + i];
+                        }
+                        axim_device->return_data_push(chunk, req_id, j);
+                    }
+                } else {
+                    std::cout << "  [AXIM HW] Warning: OTP FIFO empty during decryption.\n";
+                    exit(1);
+                }
+            }
+            if (output_direction == false){
+                // SPMへ書き込み
+                spm_device->copy(spm_offset, output_data.data(), 64);
+            }
+            m_start_reg = 0; // idle
+            return; 
+        } else {
+            return;
+        }
+    }
+    
+    // // AESモジュールが呼び出す。
+    // bool do_xor(uint64_t command){
+    //     if (m_start_reg != 0) return false; // busy
+    //     // commandの内訳
+    //     // | 63 - 32 | 31 - 2 | 1 | 0 |
+    //     // |  req_id |  spm_offset  | out_dir | in_dir |
+    //     input_direction = (command & 1ULL) ? true : false; // 0: from SPM, 1: from Req I/O
+    //     output_direction = (command & 2ULL) >> 1 ? true : false; // 0: to SPM, 1: to Req I/O
+    //     req_id = (command >> 32) & 0xFFFFFFFF;
+    //     spm_offset = (command >> 2) & 0x3FFFFFFF;
+    //     m_start_reg = 1;
+    //     return true;
+    // }
+    
+    bool copy(uint8_t buf[64]){
+        // SPMデータ窓に書き込み
+        // output_dataのデータをprint
+        memcpy(buf, output_data.data(), 64);
+        return true;
+    }
+    bool write(uint8_t buf[64]){
+        // SPMデータ窓から読み込み
+        // input_dataにで
+        memcpy(input_data.data(), buf, 64);
+        return true;
+    }
+
+private:
+
+
+    sim_t* sim;
+    axim_mmio_device_t* axim_device;
+    spm_device_t* spm_device;
+    // --- 内部状態 ---
+    std::queue<Otp> m_otp_fifo;
+    std::queue<uint64_t> m_command_fifo;
+    DataBlock input_data; //  Buffer
+    DataBlock output_data; // Buffer
+    
+    bool input_direction = false; // false : from SPM, true : from Req I/O
+    bool output_direction = false; // false : to SPM, true : to Req I/O
+    uint32_t req_id = 0;
+    uint32_t spm_offset = 0;
+    // MMIOレジスタの状態
+    uint64_t m_start_reg = 0;
+};
