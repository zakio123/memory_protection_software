+// mem領域（base, mem_t*）を作って sim_t を生成して返す簡易API
+// ※ 失敗時は例外を投げる設計にしておく
+struct spike_boot_args {
+  bool debug=false, halted=false, histogram=false, log=false;
+  bool socket=false, dtb_enabled=true;
